# Entorno: development | demo | staging | production
ENVIRONMENT=development
# Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/harvestt
# Obligatorio fuera de development (python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=
ACCESS_TOKEN_MINUTES=720
# Solo si el frontend se sirve desde otro origen
CORS_ORIGINS=

# Seed inicial (idempotente en cada arranque)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ORG_NAME=HarvestT
SEED_ORG_SLUG=harvestt
# Organización cuyos prototipos públicos aparecen en la vitrina
PUBLIC_ORG_SLUG=harvestt
# Sitio histórico de la página Visión (etiqueta y coordenadas aproximadas a ciudad)
PUBLIC_ORIGIN_LABEL=CDMX · prototipos históricos
PUBLIC_ORIGIN_LAT=19.4
PUBLIC_ORIGIN_LON=-99.1
# 1 = crea el proyecto "Invernadero demostrativo" con sensores y reglas demostrativas (V3). Apagado en producción.
SEED_DEMO_SIMULATION=0

# Archivos: local (dev) | s3 (bucket de Railway)
STORAGE_BACKEND=local
STORAGE_DIR=storage
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ADDRESSING_STYLE=virtual

# Base de las IRI de la ontología pública: cambiará con harvestt.org; lo permanente es el ID HVT.
ONTOLOGY_BASE_IRI=https://harvestt-production.up.railway.app/api/v1/public/ontology/terms/

# Token de la API de Genesys (pídelo a helpdesk@genesys-pgr.org); vacío = fuente "Requiere credenciales".
GENESYS_API_TOKEN=
